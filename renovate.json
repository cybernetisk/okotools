{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "lockFileMaintenance": {
    "enabled": true
  },
  "dependencyDashboardApproval": true,
  "packageRules": [
    {
      "description": "okoreports: no approval needed, CI gates automerge. Own branch prefix keeps its lockfile maintenance apart from approval-gated lockfiles.",
      "matchFileNames": ["okoreports/**", ".github/workflows/okoreports.yml"],
      "dependencyDashboardApproval": false,
      "automerge": true,
      "minimumReleaseAge": "3 days",
      "minimumReleaseAgeBehaviour": "timestamp-optional",
      "additionalBranchPrefix": "okoreports-"
    },
    {
      "matchFileNames": ["okoreports/**", ".github/workflows/okoreports.yml"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "schedule": ["before 6am on monday"]
    },
    {
      "description": "@vitejs/plugin-react majors require the matching vite major",
      "matchPackageNames": ["vite", "@vitejs/plugin-react"],
      "groupName": "vite"
    }
  ]
}
